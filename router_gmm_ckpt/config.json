{
  "model_name": "Qwen/Qwen2.5-Coder-1.5B",
  "output_dir": "./router_gmm_ckpt",
  "dataset_source": "executable",
  "executable_dataset_name": "ankhanhtran02/CL4Code-executable-datasets",
  "tasks": [
    "python",
    "cpp",
    "swift",
    "rust",
    "csharp",
    "java",
    "php",
    "typescript",
    "shell"
  ],
  "feature_layers": 4,
  "routing_dim": 256,
  "max_length": 512,
  "batch_size": 16,
  "train_k": 1000,
  "eval_k": 1000,
  "seed": 42,
  "gmm_components": 8,
  "em_iters": 50,
  "em_tol": 0.0001,
  "variance_floor": 0.0001,
  "eps": 1e-08,
  "omega_min": 0.05,
  "kappa": 0.0,
  "tau_n": 1.0,
  "eval_split": "test",
  "save_features": true,
  "force_recompute_features": true
}